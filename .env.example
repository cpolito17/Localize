# Google Maps Platform credentials. Never commit real values.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Optional Google Maps configuration.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Public container port.
LOCALIZE_PORT=8080

# Anonymous-use safeguards. Generate the secret with `openssl rand -hex 32`.
RATE_LIMIT_SECRET=
RATE_LIMIT_SEARCHES_PER_DAY=8
RATE_LIMIT_SEARCHES_PER_MINUTE=3
RATE_LIMIT_IP_MULTIPLIER=4
RATE_LIMIT_GLOBAL_SEARCHES_PER_DAY=40
GOOGLE_API_DAILY_LIMIT=300
